# Backend configuration (place real values only in the ignored local .env)
APP_NAME=Syllabus-Aligned AI Learning Assistant API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth and PostgreSQL. Keep the service-role key backend-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# NVIDIA hosted inference API. Keep the key backend-only.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# Set the exact model ID enabled for your NVIDIA API key.
NVIDIA_MODEL=
CHROMA_PERSIST_DIR=./data/index/chroma_multilingual_e5_large
EMBEDDING_MODEL=intfloat/multilingual-e5-large
